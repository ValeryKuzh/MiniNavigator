<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<configSections>
		<section name="entityFramework"
				 type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection,
             EntityFramework, Version=6.0.0.0, Culture=neutral,
             PublicKeyToken=b77a5c561934e089"
				 requirePermission="false" />
	</configSections>

	<startup>
		<supportedRuntime version="v4.0"
						  sku=".NETFramework,Version=v4.8" />
	</startup>

	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient"
					  type="System.Data.Entity.SqlServer.SqlProviderServices,
                EntityFramework.SqlServer" />
		</providers>
	</entityFramework>

	<connectionStrings>

		<!-- Подключение к InterMech -->
		<add name="InterMechDbConnection"
			 connectionString="Server=IM1834\SQLEXPRESS;Database=MiniNavigatorDb;Trusted_Connection=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />

		<!-- Подключение к домашней БД -->
		<add name="HomeDbConnection"
			 connectionString="Server=localhost;Database=MiniNavigatorDb;Trusted_Connection=True;"
			 providerName="System.Data.SqlClient" />

	</connectionStrings>

</configuration>
